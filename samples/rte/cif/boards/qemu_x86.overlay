#include <freq.h>
/ {
	mcb0: mcb@0 {
		compatible = "systech,mcb";
		reg = <0x20000000 DT_SIZE_K(4)
			   0x30000000 DT_SIZE_K(512)
			   0x40000000 DT_SIZE_K(512)>;
		reg-names = "reg", "rx_buf", "tx_buf";
		status = "okay";
		bandwidth = <DT_FREQ_M(1)>;
	};

	mcb1: mcb@1 {
		compatible = "systech,mcb";
		reg = <0x20000000 DT_SIZE_K(4)
			   0x30000000 DT_SIZE_K(512)
			   0x40000000 DT_SIZE_K(512)>;
		reg-names = "reg", "rx_buf", "tx_buf";
		status = "okay";
		bandwidth = <DT_FREQ_M(40)>;
	};
	aliases {
		mcbl = &mcb0;
		mcbh = &mcb1;
	};
};
