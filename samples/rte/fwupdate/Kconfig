mainmenu "FW update"

module = FWUPDATE
module-str = FWUPDATE
source "subsys/logging/Kconfig.template.log_config"

config FWUPDATE_STRICT_STRATEGY
	int "FW Update stric mode"
	default 0
	help
	  Check partition invalid using digest or signature
	  0 - No check
	  1 - digest
	  2 - signature

config FWUPDATE_AUTO_COMMIT
	bool "Auto commit fwupdate changes"
	default y
	help
	  It will start a background task and commit fwupdate changes if
	  no system crash happens.

source "Kconfig.zephyr"
