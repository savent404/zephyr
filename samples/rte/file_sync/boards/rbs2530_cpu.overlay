#include <zephyr/dt-bindings/gpio/gpio.h>
#include <common/mem.h>

&mmc0 {
	status = "okay";
	non-removable;

	usr {
		compatible = "zephyr,mmc-disk";
		status = "okay";
		bus-width = <4>;
	};
};

&mmc1 {
	status = "okay";

	cd-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>; // MIO47 is the SD card detect pin

	mmc {
		compatible = "zephyr,sdmmc-disk";
		status = "okay";
	};
};

&gpio1 {
	status = "okay";
};
