#include <mem.h>
#include <arm/armv7-a.dtsi>
#include <zephyr/dt-bindings/interrupt-controller/arm-gic.h>

/ {

	soc {
		interrupt-parent = <&gic>;

		ocm_low: memory@20000 {
			compatible = "zephyr,memory-region", "xlnx,zynq-ocm";
			reg = <0x00020000 DT_SIZE_K(256)>;
			zephyr,memory-region = "OCM_LOW";
		};

		ocm_high: memory@e1fe0000{
			compatible = "zephyr,memory-region", "xlnx,zynq-ocm";
			reg = <0xe1fe0000 DT_SIZE_K(128)>;
			zephyr,memory-region = "OCM_HIGH";
		};

		gic: interrupt-controller@f8901000 {
			compatible = "arm,gic-v1", "arm,gic";
			status = "okay";
			reg = <0xf8901000 0x1000>,
				<0xf8902000 0x100>;
			interrupt-controller;
			#interrupt-cells = <4>;
		};

		uart0: serial@e0004000 {
			compatible = "ns16550";
			// clocks = <&clkc NCLK_UART0>, <&clkc NCLK_APB_UART0>;
			// clock-names = "baudclk", "apb_pclk";
			reg = <0xE0004000 0x1000>;
			interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			interrupt-names = "irq_0";
			reg-shift = <2>;
			// reg-io-width = <4>;
			// u-boot,dm-pre-reloc;
			status = "disabled";
		};

		uart1: serial@e0023000 {
			compatible = "ns16550";
			// clocks = <&clkc NCLK_UART1>, <&clkc NCLK_APB_UART1>;
			// clock-names = "baudclk", "apb_pclk";
			reg = <0xE0023000 0x1000>;
			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			interrupt-names = "irq_0";
			reg-shift = <2>;
			// reg-io-width = <4>;
			// u-boot,dm-pre-reloc;
			status = "disabled";
		};

		gpio0: gpio@e0003000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,designware-gpio";
			// clocks = <&clkc NCLK_APB_GPIO>;
			reg = <0xe0003000 0x100>;
			interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			gpio-controller;
			ngpios = <32>;
			#gpio-cells = <2>;
			// line-name = "porta";
			status = "disabled";
		};

		gpio1: gpio@e0003100 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,designware-gpio";
			// clocks = <&clkc NCLK_APB_GPIO>;
			reg = <0xe0003100 0x100>;
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			gpio-controller;
			ngpios = <22>;
			#gpio-cells = <2>;
			// line-name = "portb";
			status = "disabled";
		};

		gpio2: gpio@e0003200 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,designware-gpio";
			// clocks = <&clkc NCLK_APB_GPIO>;
			reg = <0xe0003200 0x100>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			gpio-controller;
			ngpios = <32>;
			#gpio-cells = <2>;
			status = "disabled";
		};

		gpio3: gpio@e0003400 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,designware-gpio";
			// clocks = <&clkc NCLK_APB_GPIO>;
			reg = <0xe0003400 0x100>;
			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			gpio-controller;
			ngpios = <32>;
			#gpio-cells = <2>;
			status = "disabled";
		};


		arch_timer: timer@e0008000 {
			compatible = "arm,armv8-timer";
			reg = <0xE0008000 0x1000>;
			interrupts =
				<GIC_PPI 13 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				<GIC_PPI 14 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				<GIC_PPI 11 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				<GIC_PPI 10 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			// clock-frequency = <15000000>; // 15MHz
			// not supported: arm,cpu-register-not-fw-configured;
		};

	};

	slcr: slcr@e0026000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "fmsh,psoc-slcr", "syscon";
		reg = <0xe0026000 0x1000>;

		ranges;

		clkc: clkc@100 {
			// u-boot,dm-pre-reloc;
			compatible = "fmsh,psoc-clkc";
			reg = <0x100 0x100>;
			#clock-cells = <1>;
			ps-clk-frequency = <33333333>;
			osc-clk-frequency = <32765>;
			fclk-enable = <0>;
			clock-output-names = "armpll", "ddrpll", "iopll",
						"cpu", "axi", "ahb", "apb", "axi_cpu",
						"ddrx1", "ddrx4", "axi_ddr",
						"apb_ddr", "gtimer",
						"gmac0_tx", "gmac1_tx", "fclk0",
						"fclk1", "fclk2", "fclk3",
						"gmac0_rx", "gmac1_rx","axi_gmac0",
						"axi_gmac1", "ahb_gmac0", "ahb_gmac1",
						"ahb_smc", "ahb_nfc", "nfc",
						"qspi", "ahb_qspi", "apb_qspi",
						"sdio0", "sdio1",
						"ahb_sdio0", "ahb_sdio1",
						"uart0", "uart1",
						"apb_uart0", "apb_uart1",
						"spi0", "spi1", "apb_spi0", "apb_spi1",
						"apb_can0", "apb_can1", "apb_gpio",
						"apb_i2c0", "apb_i2c1",
						"ahb_usb0", "ahb_usb1", "usb0_phy",
						"usb1_phy", "ahb_dmac", "wdt", "apb_wdt",
						"ttc0_ref1", "ttc0_ref2", "ttc0_ref3",
						"ttc1_ref1", "ttc1_ref2", "ttc1_ref3",
						"apb_ttc0", "apb_ttc1", "ahb_pcap";
		};

		pinctrl0: pintrl@700 {
			compatible = "xlnx,pinctrl-zynq";
			reg = <0x700 0x200>;
			syscon = <&slcr>;
		};
	};

};
