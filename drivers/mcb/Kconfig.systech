config MCB_SYSTECH
		bool "Systech MCB driver"
		default y
		depends on DT_HAS_SYSTECH_MCB_ENABLED
		help
			Enable Systech MCB driver.

config MCB_SYSTECH_BUFFER_MAX_LENGTH
		int "length of tx&rx buffer"
		default 2048
		depends on MCB_SYSTECH
		help
			Limit of the max buffer length.

config MCB_SYSTECH_HW_WORKAROUND
		bool "HW temporary solution"
		default y
		depends on MCB_SYSTECH
		help
			This is for HW workaround solutions

config MCB_SYSTECH_PANIC_ON_HW_ERROR
		bool "Panic on unexpected MCB hardware errors"
		default n
		depends on MCB_SYSTECH
		help
			Call k_panic() when the driver detects unexpected MCB hardware
			behavior. This option is intended for hardware diagnostics and
			must not be enabled in production builds.

config MCB_SYSTECH_TX_CTRL1_VERIFY
		bool "Verify CTRL1 register after TX trigger"
		default n
		depends on MCB_SYSTECH
		help
			Enable readback verification of the CTRL1 register after
			triggering TX. This is intended for debugging register write
			mismatch issues.

config MCB_SYSTECH_BUFFER_ALIGN
		int "tx&rx buffer align size"
		default 1
		depends on MCB_SYSTECH
		help
			This is for HW design limitation, once 8-bit write
			is supported, you can change it to 1.
