/dts-v1/;

#include <fmsh/rbs2530.dtsi>


&ethernet0 {
	pinctrl-0 = <&mdio0_clk_mio_52>, <&mdio0_data_mio_53>;
	pinctrl-names = "default";
	mdio-addr = <1>;
	gmii2rgmii-addr1 = <0x8>;
	gmii2rgmii-addr2 = <0x9>;
	phy-mode = "utp";  /* fiber or utp */
	phy-delay = <0x3c0c>;
	fixed-speed = <2>;  /* 0:10M, 1:100M, 2:1000M */
	auto-negotiation = <1>;
	local-ip-address = "192.168.10.15";
	local-netmask = "255.255.255.0";
	local-gateway = "192.168.10.1";
	local-mac-address = [8C 1F 64 5A E1 A5];
	status = "okay";
};

&ethernet1 {
	pinctrl-0 = <&mdio0_clk_mio_52>, <&mdio0_data_mio_53>;
	pinctrl-names = "default";
	mdio-addr = <1>;
	gmii2rgmii-addr1 = <0x8>;
	gmii2rgmii-addr2 = <0x9>;
	phy-mode = "none";  /* fiber or utp or none */
	phy-delay = <0x3c0c>;
	/* This GMAC only supports forced 100Mbps mode */
	fixed-speed = <1>;
	/* auto-negotiation is disabled since speed is forced to 100Mbps */
	auto-negotiation = <0>;
	local-ip-address = "192.168.11.15";
	local-netmask = "255.255.255.0";
	local-gateway = "192.168.11.1";
	local-mac-address = [8C 1F 64 5A E1 B5];
	status = "disabled";
};
