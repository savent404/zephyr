/dts-v1/;

#include <freq.h>
#include <zephyr/dt-bindings/pinctrl/fmql-pinctrl.h>
#include <fmsh/fmql_psoc.dtsi>
#include <fmsh/fmql_pinctrl.dtsi>

/ {
	model = "QEMU Cortex-A7";
	compatible = "fmsh,fmql20", "arm,cortex-a7";
	interrupt-parent = <&gic>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
		};
	};

	sram0: memory@100000 {
		compatible = "mmio-sram";
		reg = <0x00100000 DT_SIZE_M(512)>;
	};

	flash0: flash@0 {
		reg = <0x00000000 DT_SIZE_M(256)>;
	};

	chosen {
		zephyr,flash      = &flash0;
		zephyr,sram       = &ddr;
		zephyr,console    = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,ocm        = &ocm_low;
		zephyr,uart-pipe  = &uart1;
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_rx_mio_9>, <&uart1_tx_mio_8>;
	pinctrl-names = "default";
};
