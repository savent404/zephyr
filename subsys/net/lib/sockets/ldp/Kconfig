#
config LDP
	bool "LDP support"
	default n
	select MCB
	select CPP
	select REQUIRES_FULL_LIBCPP
	select PTHREAD_IPC
	help
	  This option enables LDP support
	  and is the basis for higher level protocols (e.g. LDP protocols).

config LDP_MAX_HARQ
	int "Maximum LDP HARQ depth"
	depends on LDP
	default 4
	range 1 128
	help
	  This option specifies the maximum depth of the LDP HARQ FIFO buffer.
	  A larger value allows for more packets to be queued for retransmission
	  but consumes more memory.

config CIF_ASYNC_BOOTSTRAP_CREDITS
	int "Initial CIF async bandwidth-control credits"
	depends on LDP
	default 5
	range 3 5
	help
	  Give each newly created async connection this many one-time initial
	  transfer credits. These credits allow a bounded startup burst before
	  periodic bandwidth-control allocation becomes available. After they
	  are exhausted, regular bandwidth control still applies.

config CIF_WQ_NORMAL_MAX_OVERDUE_US
	int "Maximum CIF normal work item overdue time"
	depends on LDP
	default 100000
	range 1 2147483647
	help
	  Force one overdue normal-priority work item before continuing due
	  high-priority work when lateness is strictly greater than this value.

config CIF_WQ_DIAGNOSTIC_REPORT_INTERVAL_MS
	int "CIF work queue diagnostic report interval"
	depends on LDP
	default 1000
	range 100 60000
	help
	  Report continuing callback overruns and forced normal dispatches no more
	  than once per interval. First events are reported immediately.
