# LDP (low data protocol for custom back-plane bus) support

# Copyright (c) 2025 SYSTech Co.
# SPDX-License-Identifier: Apache-2.0
#
#
config LDP
	bool "LDP support"
	default n
	select MCB
	select CPP
	select REQUIRES_FULL_LIBCPP
	select PTHREAD_IPC
	help
	  This option enables LDP support
	  and is the basis for higher level protocols (e.g. LDP protocols).

config LDP_MAX_HARQ
	int "Maximum LDP HARQ depth"
	depends on LDP
	default 4
	range 1 128
	help
	  This option specifies the maximum depth of the LDP HARQ FIFO buffer.
	  A larger value allows for more packets to be queued for retransmission
	  but consumes more memory.
